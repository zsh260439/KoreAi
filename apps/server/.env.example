# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Database / Queue
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/KoreAi
REDIS_HOST=localhost
REDIS_PORT=6379

# File storage
KNOWLEDGE_UPLOAD_DIR=storage/knowledge-documents

# Embedding provider, OpenAI-compatible
EMBEDDING_BASE_URL=https://your-embedding-provider/v1
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_MODEL=text-embedding-3-small

# Chat model provider, OpenAI-compatible
LLM_BASE_URL=https://your-llm-provider/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_chat_model

# Optional query-analysis override
RETRIEVAL_QUERY_ANALYSIS_MODEL=
RETRIEVAL_QUERY_ANALYSIS_TEMPERATURE=

# Optional CE rerank provider
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Optional OCR/VLM provider, OpenAI-compatible
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_TIMEOUT_MS=30000
OCR_MAX_IMAGES_PER_DOCUMENT=20

# Optional MinerU
PDF_PARSER_MODE=auto
MINERU_BASE_URL=
MINERU_API_BASE_URL=
MINERU_API_KEY=
MINERU_MODEL_VERSION=
MINERU_TIMEOUT_MS=120000
MINERU_DEBUG_DIR=storage/mineru-debug
